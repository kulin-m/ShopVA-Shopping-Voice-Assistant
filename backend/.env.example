# ── Server Configuration ──────────────────────────────────────────────────────
PORT=8000
SECRET_KEY=your_production_jwt_secret_key_here
FRONTEND_URL=https://your-frontend-app.vercel.app

# ── Groq LLM Configuration ────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Supabase & Database Configuration ─────────────────────────────────────────
# For production (Supabase PostgreSQL):
# DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# For local development (SQLite fallback):
DATABASE_URL=sqlite:///./voice_shopping.db
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

# ── Qdrant Vector Search Configuration ───────────────────────────────────────
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=products
