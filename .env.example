# ── Voice Shopping Assistant Environment Configuration ──────────────────────
# Copy this file to backend/.env and frontend/.env respectively.

# Backend (.env in backend/ directory)
PORT=8000
SECRET_KEY=your_production_jwt_secret_key_here
FRONTEND_URL=https://your-frontend-app.vercel.app
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
DATABASE_URL=sqlite:///./voice_shopping.db
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key
QDRANT_URL=https://your-qdrant-cluster-url.qdrant.tech
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=products

# Frontend (.env in frontend/ directory)
VITE_API_BASE_URL=http://localhost:8000
